#!/bin/sh

# Determine git details
REPO_DIR=$(git rev-parse --show-toplevel 2>/dev/null)
if [ -z "$REPO_DIR" ]; then
    exit 0
fi

REPO_NAME=$(basename "$REPO_DIR")
SCOPE="repo:$REPO_NAME"

# Get last commit details
COMMIT_SHA=$(git rev-parse --short HEAD 2>/dev/null)
COMMIT_MSG=$(git log -1 --pretty=%B 2>/dev/null)

if [ -z "$COMMIT_SHA" ] || [ -z "$COMMIT_MSG" ]; then
    exit 0
fi

# Locate the ltm binary
LTM_BIN="ltm"
if [ -f "$HOME/.local/bin/ltm" ]; then
    LTM_BIN="$HOME/.local/bin/ltm"
fi

# Build payload
key="commit-$COMMIT_SHA"
value="Commit summary for repository '$REPO_NAME':
SHA: $COMMIT_SHA
Message: $COMMIT_MSG"

# Call ltm to save the context into the repo scope
if command -v "$LTM_BIN" >/dev/null 2>&1; then
    # Disable auto-conflict-resolution for commits as they are historical logs and should not supersede each other.
    LTM_CONFLICT_DISABLE=1 "$LTM_BIN" --scope "$SCOPE" save "$key" "$value" "git,commit" >/dev/null 2>&1
fi
